REDIS_PASSWORD=replace-with-a-strong-redis-password
SESSION_SECRET=replace-with-a-long-random-session-secret
CRYPTO_SECRET=replace-with-a-long-random-cache-secret

# Default: leave SQL_DSN empty to use the shared SQLite database in /data.
SQL_DSN=

# PostgreSQL profile:
# SQL_DSN=postgresql://newapi:replace-with-a-strong-database-password@postgres:5432/new-api
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# MySQL profile:
# SQL_DSN=newapi:replace-with-a-strong-database-password@tcp(mysql:3306)/new-api?charset=utf8mb4&parseTime=true&loc=Local
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-database-password
